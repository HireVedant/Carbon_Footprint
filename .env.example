# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Your Apps
# Navigate to https://console.firebase.google.com

# Firebase API Key
VITE_FIREBASE_API_KEY=YOUR_API_KEY_HERE

# Firebase Auth Domain (e.g., your-project.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase Project ID
VITE_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket (e.g., your-project.appspot.com)
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Firebase Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000

# Firebase App ID
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef0000000000000000

# Instructions:
# 1. Duplicate this file and name it `.env`
# 2. Fill in the actual values from your Firebase project
# 3. NEVER commit `.env` to version control
# 4. `.gitignore` already includes `.env` - it will be ignored automatically
